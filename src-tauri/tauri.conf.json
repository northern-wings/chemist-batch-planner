{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chemist Batch Planner",
  "version": "1.0.0",
  "identifier": "com.northernwings.chemistbatchplanner",
  "build": {
    "frontendDist": "../docs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chemist's Batch Planner",
        "width": 1360,
        "height": 900,
        "minWidth": 420,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Plans Funky Station chemistry batches.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
